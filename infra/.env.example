# Copy to infra/.env before `docker compose up`. Never commit the real file.

# Keys the gateway accepts in the x-api-key header. Comma-separated for several
# (e.g. one per developer). Required — the gateway refuses to start without it.
# Generate one with:  openssl rand -hex 24
API_KEYS=dev-local-key-change-me

# Host port the gateway is published on. The app's .env must agree.
GATEWAY_PORT=8080

# info | warn | error | debug — JSON lines either way, containers prefer it.
LOG_LEVEL=info

# Requests per key per window (ms).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# How long the gateway waits on the nutrition service before returning 502.
UPSTREAM_TIMEOUT_MS=3000

# Minimum fuzzy-match quality (0..1, 1 = exact) before a lookup 404s.
MATCH_THRESHOLD=0.45
