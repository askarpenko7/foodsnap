{
  "name": "foodsnap",
  "version": "0.1.0",
  "private": true,
  "description": "Point your camera at food — on-device classification via native modules, nutrition via a gateway-fronted TypeScript backend.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "yarn workspaces foreach --all --parallel run typecheck"
  },
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
