# Copy to apps/mobile/.env — the real file is gitignored. Values are baked into
# the build by react-native-config, so a change needs a rebuild, not just a reload.

# Base URL of the gateway, no trailing slash.
#
#   Android emulator  -> http://10.0.2.2:8080   (10.0.2.2 is the host loopback;
#                                                "localhost" is the emulator itself)
#   iOS simulator     -> http://localhost:8080
#   physical device   -> http://<your-LAN-ip>:8080
GATEWAY_URL=http://10.0.2.2:8080

# Must match one of the keys in the gateway's API_KEYS (see infra/.env.example).
# This is a local development secret, not a production one — a shipped app cannot
# keep a key secret, which is why the real fix is per-user tokens (see roadmap).
API_KEY=dev-local-key-change-me
