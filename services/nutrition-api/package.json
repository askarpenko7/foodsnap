{
  "name": "@foodsnap/nutrition-api",
  "version": "0.0.0",
  "private": true,
  "description": "Internal nutrition lookup service — fuzzy-matches a food label against a bundled database",
  "license": "MIT",
  "author": "Alexander Karpenko (https://github.com/askarpenko7)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foodsnap/shared": "workspace:*",
    "fastify": "5.10.0",
    "fuse.js": "7.5.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
